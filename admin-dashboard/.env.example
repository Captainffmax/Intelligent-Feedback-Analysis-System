# Admin Dashboard environment template — copy to `.env`

# MongoDB (same cluster the backend writes to)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=feedback_analysis_db

# Base URL of the FastAPI backend (for Tier-D summarization calls)
BACKEND_API_URL=http://localhost:8000
