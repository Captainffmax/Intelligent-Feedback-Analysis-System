# ==========================================================================
# Intelligent Feedback Analysis System — Backend Environment Template
# --------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
# NEVER commit the populated `.env` file to version control.
# ==========================================================================

# --- MongoDB Atlas (Async Motor connection) ------------------------------
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=feedback_analysis_db

# Server-selection / connection timeout in milliseconds (fail fast on
# unstable campus networks instead of hanging the request).
MONGO_TIMEOUT_MS=5000

# --- Gemini 1.5 Flash (Tier D — Qualitative Summarization) ---------------
GEMINI_API_KEY=your-google-generative-ai-key-here
GEMINI_MODEL=gemini-3.6-flash

# --- Hugging Face / DistilBERT (Tier B) ----------------------------------
SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
# Confidence below this threshold is re-labelled NEUTRAL (SST-2 is binary).
NEUTRAL_THRESHOLD=0.60

# --- spaCy (Tier A) ------------------------------------------------------
SPACY_MODEL=en_core_web_sm

# --- Administrator Authentication (JWT) ----------------------------------
# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-generate-a-64-char-hex-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- Seed script defaults (used only by scripts/seed.py) -----------------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_ADMIN_ROLE=ICT Admin

# --- CORS: comma-separated origins allowed to reach this API -------------
# Student PWA (Vite dev) + Streamlit admin dashboard.
# The student app is served by the backend itself, so it is SAME-ORIGIN and
# needs no entry here. The admin dashboard calls the API server-side (CORS is a
# browser mechanism), so it needs none either. Only the Vite dev server on 5173
# is cross-origin — and localhost never changes, so this works on any network.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
